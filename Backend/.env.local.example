# Local secrets for migration scripts (gitignored). Copy to .env.local and fill in.
#
# AWS (from IAM user rezervame-render-s3):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=rezervame-assets-abs
S3_PUBLIC_BASE_URL=https://rezervame-assets-abs.s3.ap-southeast-2.amazonaws.com
S3_UPLOAD_PREFIX=uploads
#
# Production RDS (URL-encode # and * in password):
# DATABASE_URL=postgresql://rezervame:ENCODED_PASS@rezervame-db.crm40scqovh9.ap-southeast-2.rds.amazonaws.com:5432/rezervame?sslmode=require
#
# Render cron (same as Render → Environment → CRON_SECRET):
CRON_SECRET=
