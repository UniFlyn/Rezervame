# Copy this file to .env and adjust DATABASE_URL if your local Postgres user/password/db differ.
#
# Standard localhost URL (matches Backend/docker-compose.yml):
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# After Postgres is running:
#   cd Backend && npm install && npx prisma generate && npm run prisma:push && npm run prisma:seed && npm run start:dev
#
# Start Postgres with Docker (from Backend/):
#   docker compose up -d
#
# Or use Postgres.app / Homebrew: create database "rezervame" and a user, then set DATABASE_URL accordingly.
#
# Mobile: iOS Simulator + Android Emulator use the correct host automatically.
# Physical device: flutter run --dart-define=API_BASE_URL=http://YOUR_LAN_IP:4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rezervame?schema=public"
PORT=4000
JWT_SECRET=change-me-in-production
SESSION_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
WEB_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001
# Browser push (generate: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@rezervame.com
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
