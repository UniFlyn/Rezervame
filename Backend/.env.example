# Copy this file to .env and adjust DATABASE_URL if your local Postgres user/password/db differ.
#
# Standard localhost URL (matches Backend/docker-compose.yml):
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# After Postgres is running:
#   cd Backend && npm install && npx prisma generate && npm run prisma:push && npm run prisma:seed && npm run start:dev
#
# Start Postgres with Docker (from Backend/):
#   docker compose up -d
#
# Or use Postgres.app / Homebrew: create database "rezervame" and a user, then set DATABASE_URL accordingly.
#
# --- Database: keep TWO environments ---
# 1) Local dev (this file → localhost Postgres via docker compose)
# 2) Production (Render env vars → Neon / Supabase / AWS — never commit prod URLs)
#
# Mobile + Web default to live API: https://rezervame.onrender.com/api
# Local full stack: set DATABASE_URL here, run `npm run start:dev`, then:
#   Web: NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000/api in .env.development.local
#   Mobile: flutter run --dart-define=API_BASE_URL=http://10.0.2.2:4000  (Android emulator)
#
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rezervame?schema=public"
# Production (set only on Render — see Backend/docs/DATABASE-OPTIONS.md):
# Supabase pooled: postgresql://postgres.[ref]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Render Postgres: auto-set from render.yaml → rezervame-db
# Neon pooled: postgresql://...@ep-xxx-pooler.neon.tech/neondb?sslmode=require
PORT=4000
JWT_SECRET=change-me-in-production
SESSION_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
WEB_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001
# Browser push (generate: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@rezervame.com
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Postmark (transactional email — rezervame.com verified)
POSTMARK_API_KEY=
POSTMARK_FROM_EMAIL=noreply@rezervame.com
POSTMARK_REPLY_TO=soporte@rezervame.com
POSTMARK_MESSAGE_STREAM=outbound
# Optional: secure webhooks (set same value in Postmark → Webhooks → custom header)
POSTMARK_WEBHOOK_TOKEN=

# Cron: booking reminder emails (POST /api/cron/booking-reminders)
CRON_SECRET=

# Wompi Panama + Yappy — add when bank credentials are ready (see docs/PAYMENTS-PANAMA.md)

# AWS S3 (images — see Backend/docs/AWS-S3-BUCKET-SETUP.md)
AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=
S3_PUBLIC_BASE_URL=https://YOUR_BUCKET.s3.ap-southeast-2.amazonaws.com
S3_UPLOAD_PREFIX=uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# WOMPI_PUBLIC_KEY=
# WOMPI_PRIVATE_KEY=
# YAPPY_MERCHANT_ID=
# YAPPY_SECRET_TOKEN=
