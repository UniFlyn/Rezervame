aws_region   = "us-east-1"
project_name = "rezervame"
environment  = "staging"

vpc_cidr             = "10.30.0.0/16"
public_subnet_cidrs  = ["10.30.1.0/24", "10.30.2.0/24"]
private_subnet_cidrs = ["10.30.11.0/24", "10.30.12.0/24"]
single_nat_gateway   = true

container_image = "123456789012.dkr.ecr.us-east-1.amazonaws.com/rezervame-backend-staging:latest"
container_port  = 4000
desired_count   = 2
min_count       = 2
max_count       = 4
task_cpu        = 1024
task_memory     = 2048

db_name                        = "rezervame"
db_username                    = "rezervame_app"
db_password                    = "replace-me"
db_instance_class              = "db.t3.medium"
db_allocated_storage           = 100
db_multi_az                    = true
db_backup_retention_days       = 7
db_read_replica_enabled        = false
db_read_replica_instance_class = "db.r6g.large"

redis_node_type         = "cache.t3.micro"
redis_num_cache_clusters = 1

# Optional: wire to existing SNS topic for alarms.
alarm_sns_topic_arn = ""
