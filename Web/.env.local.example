# Copy to .env.local and adjust as needed.

# Google Maps (optional — map pickers)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# API base — defaults to live Render if unset (see src/lib/apiBase.ts).
# Uncomment only when running Nest locally against local Postgres:
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000/api
